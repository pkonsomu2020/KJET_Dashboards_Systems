# ── Server ────────────────────────────────────────────
PORT=4000
NODE_ENV=development

# ── PostgreSQL (local) ─────────────────────────────────
PGHOST=localhost
PGPORT=5432
PGDATABASE=kjet
PGUSER=kjet_user
PGPASSWORD=kjet_pass

# ── Redis (local) ──────────────────────────────────────
REDIS_URL=redis://localhost:6379

# ── Better Auth ────────────────────────────────────────
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
BETTER_AUTH_SECRET=replace_with_32_byte_hex_secret
BETTER_AUTH_URL=http://localhost:4000

# OAuth providers (optional — leave blank to disable)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# ── CORS ───────────────────────────────────────────────
# Comma-separated list of allowed frontend origins
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# ── Cache TTLs (seconds) ───────────────────────────────
CACHE_TTL_PORTFOLIO=300       # 5 minutes — overview KPIs
CACHE_TTL_CLUSTER_LIST=120    # 2 minutes — cluster list
CACHE_TTL_CLUSTER_DETAIL=600  # 10 minutes — single cluster full profile
